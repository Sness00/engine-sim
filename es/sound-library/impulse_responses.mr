// Contains all "smooth" impulse responses from smooth_01 to smooth_49 //

private import "engine_sim.mr"

public node impulse_response_library {
    output default_0: impulse_response(filename: "smooth/smooth_39.wav", volume: 0.001); // smooth_39 is already here

    output real_engine_0:
        impulse_response(filename: "archive/test_engine_14_eq_adjusted_16.wav", volume: 0.001);
