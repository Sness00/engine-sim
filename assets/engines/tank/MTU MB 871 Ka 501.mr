// Ange The Great Engine Simulator v0.1.14A //
// Engine Simulator Official Discord: https://discord.gg/engine-sim-official //

// Engine created by pilot01, LTSP6.1.1 and engine template made by Archangel Motors, credits to Oror for the lobe gen //
// Discord: pilot01#8251 //
// Discord: archangelmotors#5271 //
// Discord: oror#4786 //




// Imports Start //

import "engine_sim.mr"

units units()
constants constants()

impulse_response_library ir_lib()

// Imports End //



// Simulation Parameters Start //

label SIM_f(15000)    // Simulation frequency. Units: Hertz. //
label SIM_SLESd(128)    // System of linear equations solver maximum steps. //
label SIM_FSd(8)    // Fluid simulation steps. //
label SIM_MCf(0.0)    // Misfire correction factor. Shifts the point where "ignition advance = firing interval" misfire bug occurs. Units: degrees. //
label AUDIO_CONV(1.0)    // Audio convolution. //
label AUDIO_HFG(1.0)    // Audio high frequency gain. //
label AUDIO_HFN(0.725)    // Audio high frequency noise. //
label AUDIO_LFN(1.0)    // Audio low frequency noise. //

// Simulation Parameters End //



// Main Parameters Start //

label EC_N(8.0)    // Cylinder amount. Does not create cylinders automatically. //
label ECB_N(2.0)    // Cylinder bank amount. Does not create cylinder banks automatically. //

label E_B(170.0)    // Cylinder bore diameter. Units: millimeters. //
label E_S(175.0)    // Piston stroke. Units: millimeters. //

label E_omegamax(2600.0)    // Maximum engine speed. Units: Revolutions per minute. //
label LICO_t(0.35)    // Engine speed limiter ignition cut-off duration. Units: seconds. //
label TACHO_REDLINE(E_omegamax)    // Redline. Determines at what speed the redline is drawn on the tachometer. Units: revolutions per minute. //

label SM_omega(250.0)    // Starter speed. Units: Revolutions per minute. //
label SM_Ftq(760.0)    // Starter torque. Units: newton meters. //

// Main Parameters End //



// Displacements //

label EC_Vcc((((((E_B / 2.0) * (E_B / 2.0)) * constants.pi) * E_S) / 1000.0))    // Single cylinder displacement. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label EC_Vci(EC_Vcc * 0.061024)    // Single cylinder displacement. Calculated automatically. Units: cubic inches. Do not tamper. //
label E_Dcc(EC_Vcc * EC_N)    // Engine displacement. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label E_Dci(EC_Vci * EC_N)    // Engine displacement. Calculated automatically. Units: cubic inches. Do not tamper. //

// Displacements //



// Piston Parameters Start //

label PCH_d(4.0)    // Piston compression height divisor. Determines the "Piston stroke/piston compression height" ratio. //
label PCH_H(E_S / PCH_d)    // Piston compression height. Calculated automatically, but can be overridden. Units: millimeters. //

label PT_H(PCH_H / 2.0)    // Piston top thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PT_V((((E_B * E_B) * constants.pi) * PT_H) / 4000.0)    // Piston top volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //

label PS_H((PCH_H * 2.5) - PT_H)    // Piston skirt height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PSI_D(E_B - (2.0 * (E_B / 15.0)))    // Piston skirt internal diameter. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PSID_V((((PSI_D * PSI_D) * constants.pi) * PS_H) / 4000.0)    // Piston skirt internal diameter volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label PSOD_V((((E_B * E_B) * constants.pi) * PS_H) / 4000.0)    // Piston skirt outer diameter volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label PS_V(PSOD_V - PSID_V)    // Piston skirt volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //

label P_rho(2.70)    // Piston material density. Units: grams per cubic centimeter //  
label P_Mm((0.15 * P_rho) / (P_rho / 7.15))    // Piston mass multiplier. Prevents the piston mass from being too low if light materials are used. Calculated automatically, override only if you are a professional. //
label P_V(PT_V + PS_V)    // Piston volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //                                             
label P_M(P_V * P_rho * P_Mm)    // Piston mass. Calculated automatically, but can be overridden. Units: grams. //

label PR_C(100.0)    // Piston rings condition. Percentage. Determines the amount of piston rings blowby. Do not use values less than 0.01 //
label PRW_L(E_B / 22.0)    // Piston rings radial wall thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PRG_L(E_B * 0.0035)    // Piston rings gap. Calculated automatically, override only if you are a professional. Units: millimeters. //
label PRG_alpha((PRG_L * 360.0) / (2.0 * constants.pi * (E_B / 2.0)))    // Piston rings gap cental angle. Calculated automatically. Units: degrees. Do not tamper. //
label PRGOS_A((((E_B / 2.0) * (E_B / 2.0)) * (PRG_alpha / 2.0)) / 100.0)    // Piston rings gap outer sector area. Calculated automatically. Units: square centimeters. Do not tamper. //
label PRGIS_A(((((E_B - (PRW_L * 2.0)) / 2.0) * ((E_B - (PRW_L * 2.0)) / 2.0)) * (PRG_alpha / 2.0)) / 100.0)    // Piston rings gap inner sector area. Calculated automatically. Units: square centimeters. Do not tamper. //
label PRG_A(PRGOS_A - PRGIS_A)    // Piston rings gap area. Calculated automatically. Units: square centimeters. Do not tamper. //
label PR_Bm(1.0 / PR_C)    // Piston rings blowby multiplier. Prevents the blowby from being too high by default. Calculated automatically, overridde only if you are a professional. //
label PR_B((PRG_A * 0.155 * 146.0) * PR_Bm)    // Piston rings blowby. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //

// Piston Parameters End //



// Connecting Rod Parameters Start //

label CR_R(1.75)    // Connecting rod ratio. Determines the "connecting rod length/stroke" ratio. //
label CR_L(E_S * CR_R)    // Connecting rod length. Calculated automatically, but can be overridden. Units: millimeters. //
label CR_T(E_B / 3.5)    // Connecting rod thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CR_W(E_B / 3.0)    // Connecting rod width. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CR_V((CR_L * CR_T * CR_W) / 1000.0)    // Connecting rod volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //

label CR_rho(7.85)    // Connecting rod material density. Units: grams per cubic centimeter //
label CR_Mm((0.15 * CR_rho) / (CR_rho / 7.15))    // Connecting rod mass multiplier. Prevents the connecting rod mass from being too low if light materials are used. Calculated automatically, override only if you are a professional. //
label CR_M(CR_V * CR_rho * CR_Mm)    // Connecting rod mass. Calculated automatically, but can be overridden. Units: grams. //

label CR_MOI(((1.0 / 12.0) * (CR_M / 1000.0)) * (((CR_L / 1000.0) * (CR_L / 1000.0)) + ((CR_W / 1000.0) * (CR_W / 1000.0))))    // Connecting rod moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label CR_MOIC((((1.0 / 12.0) * (CR_M / 1000.0)) * ((4.0 * (((CR_L + CT_L) / 1000.0) * ((CR_L + CT_L) / 1000.0))) + ((CR_W / 1000.0) * (CR_W / 1000.0)))) * EC_N)    // Connecting rod moment of inertia applied to crankshaft. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

// Connecting Rod Parameters End //



// Crankshaft Parameters Start //

label CT_L(E_S / 2.0)    // Crankshaft throw. Calculated automatically. Units: millimeters. Do not tamper. //

label C_rho(7.85)    // Crankshaft material density. Units: grams per cubic centimeter. //
label C_Mm((0.5 * C_rho) / (C_rho / 7.15))    // Crankshaft mass multiplier. Prevents the crankshaft mass from being too low if light materials are used. Calculated automatically, override only if you are a professional. //

label CRJ_L((CR_T * EC_N) / ECB_N)    // Crankshaft rod journal(s) total length. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CRJ_D(CR_W)    // Crankshaft rod journal diameter. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CRJ_V(((constants.pi * (CRJ_D * CRJ_D)) * CRJ_L) / 4000.0)    // Crankshaft rod journal(s) total volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CRJ_MOI(((((CRJ_V * C_rho) / (EC_N / ECB_N)) / 1000.0) * ((CT_L / 1000.0) * (CT_L / 1000.0))) * (EC_N / ECB_N))    // Crankshaft rod journal(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

label CW_T(CRJ_L)    // Crankshaft web(s) total thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CW_H(CT_L + CRJ_D)    // Crankshaft web height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CW_V((CRJ_D * CW_H * CW_T) / 1000.0)    // Crankshaft web(s) total volume. Calculated automatically, override only if you are a professional. //
label CW_MOI(((1.0 / 12.0) * (((CW_V * C_rho) / ((EC_N / ECB_N) * 2.0)) / 1000.0) * (4.0 * ((CW_H / 1000.0) * (CW_H / 1000.0)) + ((CRJ_D / 1000.0) * (CRJ_D / 1000.0)))) * ((EC_N / ECB_N) * 2.0))    // Crankshaft web(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

label CMB_N((EC_N / ECB_N) + 1.0)    // Crankshaft main bearings amount. Calculated automatically, but can be overridden. //
label CMB_L(CR_T * CMB_N)    // Crankshaft main bearings total length. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CMB_D(CR_W)    // Crankshaft main bearing diameter. Calculated automatically, override only if you are a professional. Units: Millimeters. //
label CMB_V(((constants.pi * (CMB_D * CMB_D)) * CMB_L) / 4000.0)    // Crankshaft main bearings total volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CMB_MOI((1.0 / 2.0) * (((CMB_V * C_rho) / 1000.0) * ((CMB_D / 2000.0) * (CMB_D / 2000.0))))    // Crankshaft main bearings moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

label CC_H(CT_L)    // Crankshaft counterweight height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CC_W(CR_W / 2.0)    // Crankshaft counterweight width. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CC_Mm(1.0)    // Crankshaft counterweight mass multiplier. Determines the "crankshaft counterweight mass/piston and connecting rod mass". Value of 0.5 for anything that does not feature a 90-degree bank separation angle is recommended. //
label C_uM((CRJ_V + CW_V + CMB_V) * C_rho * C_Mm)    // Crankshaft unbalanced mass. Calculated automatically, override only if you are a professional. Units: grams. //
label CC_M(C_uM + ((P_M + CR_M) * CC_Mm))    // Crankshaft counterweight(s) total mass. Calculated automatically, override only if you are a professional. Units: grams. //
label CC_MOI(((1.0 / 12.0) * ((CC_M / 1000.0) / ((EC_N / ECB_N) * 2.0)) * (4.0 * ((CC_H / 1000.0) * (CC_H / 1000.0)) + ((CC_W / 1000.0) * (CC_W / 1000.0)))) * ((EC_N / ECB_N) * 2.0))    // Crankshaft counterweight(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //

label C_M(C_uM + CC_M)    // Crankshaft mass. Calculated automatically, but can be overridden. Units: grams. //
label C_MOI(CW_MOI + CRJ_MOI + CC_MOI + CMB_MOI)    // Crankshaft moment of inertia. Calculated automatically, only override if you are a professional. Units: kilograms times meters squared. //
label C_Fmu(((C_M / 1000.0) * 9.80665) * (0.0015 * CMB_N))    // Crankshaft friction. Calculated automatically, only override if you are a professional. Units: newton meters. //

label CP_D(E_S * 0.75)    // Crankshaft pulley diameter. Calculated automatically, but can be overridden. Units: millimeters. //
label CP_T(E_B * 0.33)    // Crankshaft pulley thickness. Calculated automatically, but can be overridden. Units: millimeters. //
label CP_V(((constants.pi * (CP_D * CP_D)) * CP_T) / 4000.0)    // Crankshaft pulley volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CP_rho(7.85)    // Crankshaft pulley material density. Units: grams per cubic centimeter. //
label CP_Mm((0.5 * CP_rho) / (CP_rho / 7.15))    // Crankshaft pulley mass multiplier. Prevents the crankshaft pulley mass from being too low if light materials are used. Calculated automatically, override only if you are a professional. //
label CP_M(CP_V * CP_rho * C_Mm)    // Crankshaft pulley mass. Calculated automatically, but can be overridden. Units: grams. //
label CP_MOI((1.0 / 2.0) * (CP_M / 1000.0) * ((CP_D / 2000.0) * (CP_D / 2000.0)))    // Crankshaft pulley moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label CP_Fmu(((CP_M / 1000.0) * 9.80665) * 0.0015)    // Crankshaft pulley friction. Calculated automatically, override only if you are a professional. Units: newton meters. //

label CHB_M(CC_M / EC_N)    // Crankshaft harmonic balancer mass. Calculated automatically, but can be overridden. Units: grams. //
label CHB_MOI((CHB_M / 1000.0) * ((CP_D / 2000.0) * (CP_D / 2000.0)))   // Crankshaft harmonic balancer moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label CHB_Fmu(((CHB_M / 1000.0) * 9.80665) * 0.0015)    // Crankshaft harmonic balancer friction. Calculated automatically, override only if you are a professional. Units: newton meters. //

// Crankshaft Parameters End //



// Flywheel Parameters Start //

label FW_D(E_S * 2.5)    // Flywheel diameter. Calculated automatically, but can be overridden. Units: millimeters. //
label FW_T(E_B / 4.0 * (EC_N / ECB_N))    // Flywheel thickness. Calculated automatically, but can be overridden. Units: millimeters. //
label FW_V(((constants.pi * (FW_D * FW_D)) * FW_T) / 4000.0)    // Flywheel volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label FW_rho(7.15)    // Flywheel material density. Units: grams per cubic centimeter. //
label FW_Mm((0.15 * FW_rho) / (FW_rho / 7.15))    // Flywheel mass multiplier. Prevents the flywheel mass from being too low if lighter materials are used. Calculated automatically, override only if you are a professional. //
label FW_M(FW_V * FW_rho * FW_Mm)    // Flywheel mass. Calculated automatically, but can be overridden. Units: grams. //
label FW_MOI((1.0 / 2.0) * ((FW_M / 1000.0) * ((FW_D / 2000.0) * (FW_D / 2000.0))))    // Flywheel moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label FW_Fmu(((FW_M / 1000.0) * 9.80665) * 0.0015)    // Flywheel friction. Calculated automatically, override only if you are a professional. Units: newton meters. //

// Flywheel Parameters End //



// Valvetrain Parameters Start //

label IV_N(2.0)    // Intake valve amount. //
label IV_D(E_B / 2.414)    // Intake valve diameter. Calculated automatically, but can be overridden. Units: millimeters. //
label IV_L(13.48)    // Intake valve lift. Units: millimeters. //
label IV_O(-23.0 * units.deg)    // Intake valve opening event. Measured at 0.050 inches of intake valve lift. Units: degrees of crankshaft rotation before top dead center. If the valve opens after top dead center, use negative value. //
label IV_C(10.0 * units.deg)    // Intake valve closing event. Measured at 0.050 inches of intake valve lift. Units: degrees of crankshaft rotation after bottom dead center. If the valve closes before bottom dead center, use negative value. //
label ID(IV_O + (180.0 * units.deg) + IV_C)    // Total intake duration at 0.050 inches of intake valve lift. Calculated automatically. Units: degrees of crankshaft rotation. Do not tamper. //  
label ID_delta(0.0)    // Difference between intake duration measured at 0.050 inches and 0.001 millimeters of intake valve lift. Units: degrees of crankshaft rotation. //
label IV_A(((constants.pi * ((IV_D * 0.98) * (IV_D * 0.98))) / 400.0) * IV_N)    // Intake valve(s) flow cross-sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //
label IV_Qmax(IV_A * 0.155 * 146.0)    // Intake valve(s) flow area theoretical maximum volumetric flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //


label EV_N(2.0)    // Exhaust valve amount. //
label EV_D(IV_D * 0.8625)    // Exhaust valve diameter. Calculated automatically, but can be overridden. Units: millimeters. //
label EV_L(13.36)    // Exhaust valve lift. Units: millimeters. //
label EV_O(14.0 * units.deg)    // Exhaust valve opening event. Measured at 0.050 inches of exhaust valve lift. Units: degrees of crankshaft rotation before bottom dead center. If the valve opens after bottom dead center, use negative value. //
label EV_C(-18.0 * units.deg)    // Exhaust valve closing event. Measured at 0.050 inches of exhaust valve lift. Units: degrees of crankshaft rotation after top dead center. If the valve closes before top dead center, use negative value. //
label ED(EV_O + (180.0 * units.deg) + EV_C)    // Total exhaust duration at 0.050 inches of exhaust valve lift. Calculated automatically. Units: degrees of crankshaft rotation. Do not tamper. //   
label ED_delta(0.0)    // Difference between exhaust duration measured at 0.050 inches and 0.001 millimeters of exhaust valve lift. Units: degrees of crankshaft rotation. // 
label EV_Oatdc(((180.0 * units.deg) - (EV_O + (ED_delta / 2.0))) / units.deg)    // Exhaust valve closing event. Measured at 0.001 millimeters of exhaust valve lift. Calculated automatically. Units: degrees of crankshaft rotation after top dead center. Do not tamper. //
label EV_A(((constants.pi * ((EV_D * 0.98) * (EV_D * 0.98))) / 400.0) * EV_N)    // Exhaust valve(s) flow cross-sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //
label EV_Qmax(EV_A * 0.155 * 146.0)    // Exhaust valve(s) flow area theoretical maximum volumetric flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //


label CSIL_C(((IV_C + (180.0 * units.deg) - IV_O) / 2.0) + (360.0 * units.deg))    // Camshaft intake lobe centerline. Calculated automatically. Incorrect formula used on purpose due to limitations of legacy implementation. Units: Degrees. Do not tamper. //
label CSIL_G(1.0)    // Camshaft intake lobe gamma(non-linearity). Higher values reduce intake valve lift at the intake event beginning and ending. Disabled if Oror's Lobe Generator is used. // 
label CSIL_dID(100)    // Camshaft intake lobe resolution. Higher values yield smoother intake lobe generation at the expense of loading times. Disabled if Oror's Lobe Generator is used. //

label CSEL_C((EV_C + (540.0 * units.deg) - EV_O) / 2.0)   // Camshaft exhaust lobe centerline. Calculated automatically. Incorrect formula used on purpose due to limitations of legacy implementation. Units: Degrees. Do not tamper. //
label CSEL_G(1.0)    // Camshaft exhaust lobe gamma(non-linearity). Higher values reduce exhaust valve lift at the exhaust event beginning and ending. Disabled if Oror's Lobe Generator is used. // 
label CSEL_dED(100)    // Camshaft exhaust lobe resolution. Higher values yield smoother exhaust lobe generation at the expense of loading times. Disabled if Oror's Lobe Generator is used. //


/*
{
  "cam_cfg": {
    "es_version": "0.1.14a",
    "resolution": 100,
    "intake_volume": 1.0,
    "exhaust_volume": 0.9,
    "intake_at_lift": 1.27,
    "exhaust_at_lift": 1.27,
    "intake_trim": 0.95,
    "exhaust_trim": 1.0,
    "intake_sigma": 1.55,
    "exhaust_sigma": 1.55,
    "intake_base_mult": 1.5,
    "exhaust_base_mult": 1.5,
    "intake_cos": false,
    "exhaust_cos": false,
    "equal_base_radius": true,
    "ramp_steepness": 0.0,
    "ramp_position": 0.0,
    "lift_significant_fraction": 100.0,
    "roller_tappet_radius": 0.5
  }
}
*/


label CS_N(4.0)    // Camshaft amount. Does not create camshafts automatically. //  
label CS_rho(7.85)    // Camshaft material density. Units: grams per cubic centimeter. //
label CS_Mm((0.5 * CS_rho) / (CS_rho / 7.15))    // Camshaft mass multiplier. Prevents the camshaft mass from being too low if lighter materials are used. Calculated automatically, override only if you are a professional. //


label CSB_N((EC_N / ECB_N) + 1.0)    // Camshaft bearing amount. Calculated automatically, but can be overridden. //


label CSS_L(CRJ_L + CMB_L)    // Camshaft base length. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSS_D(((IV_L + EV_L) / 2.0) * 3.0)    // Camshaft base diameter. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSS_V(((constants.pi * (CSS_D * CSS_D)) * CSS_L) / 4000.0)    // Camshaft base volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CSS_M(CSS_V * CS_rho * CS_Mm)    // Camshaft base mass. Calculated automatically, override only if you are a professional. Units: grams. //
label CSS_MOI((1.0 / 2.0) * (CS_M / 1000.0) * ((CSS_D / 2000.0) * (CSS_D / 2000.0)))    // Camshaft base moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //


label CSIL_N((IV_N * EC_N) / CS_N)    // Camshaft intake lobe amount. Calculated automatically. Do not tamper. //
label CSIL_H(IV_L)    // Camshaft intake lobe height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSIL_T(IV_D / 2.0)    // Camshaft intake lobe base thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSIL_V(((CSS_D * CSIL_H * CSIL_T) / 2000.0) * CSIL_N)    // Camshaft intake lobe(s) total volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CSIL_M(CSIL_V * CS_rho * CS_Mm)    // Camshaft intake lobe(s) mass, Calculated automatically, override only if you are a professional. Units: grams. //
label CSIL_MOI((1.0 / 12.0) * (CSIL_M / 1000.0) * ((4.0 * ((CSIL_H / 1000.0) * (CSIL_H / 1000.0))) + ((CSIL_T / 1000.0) * (CSIL_T / 1000.0))))    // Camshaft intake lobe(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //


label CSEL_N((EV_N * EC_N) / CS_N)    // Camshaft exhaust lobe amount. Calculated automatically. Do not tamper. //
label CSEL_H(EV_L)    // Camshaft exhaust lobe height. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSEL_T(EV_D / 2.0)    // Camshaft exhaust lobe base thickness. Calculated automatically, override only if you are a professional. Units: millimeters. //
label CSEL_V(((CSS_D * CSEL_H * CSEL_T) / 2000.0) * CSEL_N)    // Camshaft exhaust lobe(s) volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CSEL_M(CSEL_V * CS_rho * CS_Mm)    // Camshaft exhaust lobe(s) mass. Calculated automatically, override only if you are a professional. Units: grams. //    
label CSEL_MOI((1.0 / 12.0) * (CSEL_M / 1000.0) * ((4.0 * ((CSEL_H / 1000.0) * (CSEL_H / 1000.0))) + ((CSEL_T / 1000.0) * (CSEL_T / 1000.0))))    // Camshaft exhaust lobe(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //


label CS_M(CSS_M + ((CSIL_M + CSEL_M) / 2.0))    // Average camshaft mass. Calculated automatically, but can be overriden. Units: grams. //
label CS_Fmu((((CS_M / 1000.0) * 9.80665) * (0.0015 * CSB_N)) * CS_N)    // Total camshaft(s) friction. Calculated automatically, override only if you are a professional. Units: newton meters. //
label CS_MOI((CSS_MOI + CSIL_MOI + CSEL_MOI) * CS_N)    // Total camshaft(s) moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //


label CSG_D(CP_D * 2.0)    // Camshaft gear diameter. Calculated automatically. Units: millimeters. Do not tamper. //
label CSG_T(CP_T)    // Camshaft gear thickness. Calculated automatically, but can be overridden. Units: millimeters. //
label CSG_V(((constants.pi * (CSG_D * CSG_D)) * CSG_T) / 4000.0)    // Camshaft gear volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //
label CSG_rho(7.85)    // Camshaft gear material density. Units: grams per cubic centimeter. //
label CSG_Mm((0.5 * CSG_rho) / (CSG_rho / 7.15))    // Camshaft gear mass multiplier. Prevents the camshaft gear mass from being too low if lighter materials are used. Calculated automatically, override only if you are a professional. //
label CSG_M(CSG_V * CSG_rho * CSG_Mm)    // Camshaft gear mass. Calculated automatically, but can be overridden. Units: grams. //
label CSG_MOI(((1.0 / 2.0) * (CSG_M / 1000.0) * ((CSG_D / 2000.0) * (CSG_D / 2000.0))) * CS_N)    // Camshaft gear(s) total moment of inertia. Calculated automatically, override only if you are a professional. Units: kilograms times meters squared. //
label CSG_Fmu((((CSG_M / 1000.0) * 9.80665) * 0.0015) * CS_N)    // Camshaft gear(s) friction. Calculated automatically, override only if you are a professional. Units: newton meters. //

// Valvetrain Parameters End //



// Cylinder Head Parameters Start //

label E_CR(17.5)    // Compression ratio. Determines the "Cylinder displacement + Combustion chamber volume /Combustion chamber volume" ratio. //
label CHCC_V(EC_Vcc / (E_CR - 1.0))    // Combustion chamber volume. Calculated automatically, override only if you are a professional. Units: cubic centimeters. //


label CHIPT_Dm(0.55)    // Cylinder head intake port throat diameter multiplier. Determines the "intake port throat diameter/intake valve flow diameter" ratio. //
label CHIPT_A(((constants.pi * ((IV_D * 0.98 * CHIPT_Dm) * (IV_D * 0.98 * CHIPT_Dm))) / 400.0) * IV_N)    // Cylinder head intake port throat cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //   
label CHIPTIV_R(CHIPT_A / IV_A)    // "Cylinder head intake port throat cross sectional area/intake valve cross sectional flow area" ratio. Calculated automatically. Do not tamper. //
label CHIPT_Qmax(CHIPT_A * 0.155 * 146.0)    // Cylinder head intake port throat theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //  

label CHIP_Dm(0.70)    // Cylinder head intake port diameter multiplier. Determines the "intake port upstream diameter/intake valve flow diameter" ratio. // 
label CHIP_A(((constants.pi * ((IV_D * 0.98 * CHIP_Dm) * (IV_D * 0.98 * CHIP_Dm))) / 400.0) * IV_N)    // Cylinder head intake port upstream cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //    
label CHIPIV_R(CHIP_A / IV_A)    // "Cylinder head intake port upstream cross sectional area/intake valve flow cross sectional area" ratio. Calculated automatically. Do not tamper. // 
label CHIP_Qmax(CHIP_A * 0.155 * 146.0)    // Cylinder head intake port upstream theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //

label CHIPI_Dm(0.80)    // Cylinder head intake port inlet diameter multiplier. Determines the "intake port inlet diameter/intake port upstream diameter" ratio. // 
label CHIPI_A(((constants.pi * ((IV_D * 0.98 * CHIP_Dm * CHIPI_Dm) * (IV_D * 0.98 * CHIP_Dm * CHIPI_Dm))) / 400.0) * IV_N)    // Cylinder head intake port inlet cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //  
label CHIPIIV_R(CHIPI_A / IV_A)    // "Cylinder head intake port inlet area/intake valve flow cross sectional area" ratio. Calculated automatically. Do not tamper. // 
label CHIPI_Qmax(CHIPI_A * 0.155 * 146.0)    // Cylinder head intake port inlet theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //   

label CHIP_Vm(0.25)    // Cylinder head intake port volume multiplier. Determines the "cylinder head intake port volume/single cylinder displacement" ratio. //  
label CHIP_V(EC_Vcc * CHIP_Vm)    // Cylinder head intake port volume. Calculated automatically, override only if you are a professional. Units: cubic centimeters. //
label CHIP_L((CHIP_V / CHIPT_A) * 10.0)    // Cylinder head intake port length. Calculated automatically. Incorrect formula used on purpose due to fluid simulation limitations. Units: millimeters. Do not tamper. //

label CHIPIV_Ravg((CHIPIIV_R + CHIPIV_R + CHIPTIV_R) / 3.0)    // Mean average of cylinder head intake port and intake valve flow cross sectional areas ratios. Do not tamper. //  
label CHIPTIVRavg_R(CHIPTIV_R / CHIPIV_Ravg)    // "Cylinder head intake port throat cross sectional area/intake valve flow cross sectional area/mean average intake port and intake valve flow cross sectional area ratios" ratio. //
label CHIPIVRavg_R(CHIPIV_R / CHIPIV_Ravg)    // "Cylinder head intake port cross sectional area/intake valve flow cross sectional area/mean average intake port and intake valve flow cross sectional area ratios" ratio. //   
label CHIPIIVRavg_R(CHIPIIV_R / CHIPIV_Ravg)    // "Cylinder head intake port inlet cross sectional area/intake valve flow cross sectional area/mean average intake port and intake valve flow cross sectional area ratios" ratio. // 


label CHEPT_Dm(0.55)    // Cylinder head exhaust port throat diameter multiplier. Determines the "exhaust port throat diameter/exhaust valve flow diameter" ratio. //   
label CHEPT_A(((constants.pi * ((IV_D * 0.98 * CHEPT_Dm) * (IV_D * 0.98 * CHEPT_Dm))) / 400.0) * EV_N)    // Cylinder head exhaust port throat cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //      
label CHEPTEV_R(CHEPT_A / EV_A)    // "Cylinder head exhaust port throat area/exhaust valve flow area" ratio. Calculated automatically. Do not tamper. //    
label CHEPT_Qmax(CHEPT_A * 0.155 * 146.0)    // Cylinder head exhaust port throat theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //  

label CHEP_Dm(0.70)    // Cylinder head exhaust port downstream diameter multiplier. Determines the "exhaust port downstream diameter/exhaust valve flow diameter" ratio. // 
label CHEP_A(((constants.pi * ((IV_D * 0.98 * CHEP_Dm) * (IV_D * 0.98 * CHEP_Dm))) / 400.0) * EV_N)    // Cylinder head exhaust port downstream cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //      
label CHEPEV_R(CHEP_A / EV_A)    // "Cylinder head exhaust port downstream area/exhaust valve flow area" ratio. Calculated automatically. Do not tamper. //
label CHEP_Qmax (CHEP_A * 0.155 * 146.0)    // Cylinder head exhaust port downstream theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //  

label CHEPO_Dm(0.80)    // Cylinder head exhaust port outlet diameter multiplier. Determines the "exhaust port outlet diameter/exhaust port downstream diameter" ratio. //   
label CHEPO_A(((constants.pi * ((IV_D * 0.98 * CHEP_Dm * CHEPO_Dm) * (IV_D * 0.98 * CHEP_Dm * CHEPO_Dm))) / 400.0) * EV_N)    // Cylinder head exhaust port outlet cross sectional area. Calculated automatically, override only if you are a professional. Units: square centimeters. //      
label CHEPOEV_R(CHEPO_A / EV_A)    // "Cylinder head exhaust port outlet area/exhaust valve flow area" ratio. Calculated automatically. Do not tamper. // 
label CHEPO_Qmax(CHEPO_A * 0.155 * 146.0)    // Cylinder head exhaust port outlet theoretical maximum flow rate. Calculated automatically. Units: cubic feet per minute at 28 inches of water pressure drop. Do not tamper. //  

label CHEP_Vm(CHEPT_A / CHIPT_A)    // Cylinder head port volume multiplier. Determines the "Cylinder head intake port volume/Cylinder head exhaust port volume" ratio. Default multiplier ensures equal port length. //  
label CHEP_V(CHIP_V * CHEP_Vm)    // Cylinder head exhaust port volume. Calculated automatically, override only if you are a professional. Units: cubic centimeters. //
label CHEP_L((CHEP_V / CHEPT_A) * 10.0)    // Cylinder head exhaust port length. Calculated automatically. Incorrect formula used on purpose due to fluid simulation limitations. Units: millimeters. Do not tamper. //

label CHEPEV_Ravg((CHEPOEV_R + CHEPEV_R + CHEPTEV_R) / 3.0)    // Mean average of cylinder head exhaust port and exhaust valve flow cross sectional areas ratios. Do not tamper. //   
label CHEPTEVRavg_R(CHEPTEV_R / CHEPEV_Ravg)    // "Cylinder head exhaust port throat cross sectional area/exhaust valve flow cross sectional area/mean average exhaust port and exhaust valve flow cross sectional area ratios" ratio. // 
label CHEPEVRavg_R(CHEPEV_R / CHEPEV_Ravg)    // "Cylinder head exhaust port cross sectional area/exhaust valve flow cross sectional area/mean average exhaust port and exhaust valve flow cross sectional area ratios" ratio. // 
label CHEPOEVRavg_R(CHEPOEV_R / CHEPEV_Ravg)    // "Cylinder head exhaust port outlet cross sectional area/exhaust valve flow cross sectional area/mean average exhaust port and exhaust valve flow cross sectional area ratios" ratio. // 

// Cylinder Head Parameters End //



// Intake Parameters Start //

label IM_N(1.0)    // Intake manifold amount. Does not create intake manifolds automatically. //
label IM_VDm(0.82)   // Intake manifold velocity decay multiplier. Determines the rate of air velocity loss inside the intake manifold. //

label IMR_Romega(1500.0)    // Intake manifold runner optimal RPM. Determines the engine speed at which the intake runners perform the best in theory. //
label IMRRWT_N(12.0)    // Intake manifold runner resonance wave travel amount. Determines the theoretical amount of times the low-pressure wave travels up and down the intake runner at optimal runner RPM. //
label IMR_L((((((1.0 / (IMR_Romega / 60.0)) * ((720.0 - ((ID / units.deg) + ID_delta)) / 360.0) * 1300.0) / 2.0) / IMRRWT_N) * 304.8) - CHIP_L)    // Intake manifold runner length. Calculated automatically, but can be overridden. Units: millimeters. //
label IMR_A(CHIPI_A)    // Intake manifold runner cross-sectional area. Calculated automatically, but can be overridden. Units: square centimeters. //
label IMR_Qmax(IMR_A * 0.155 * 146.0)    // Intake manifold runner theoretical maximum volumetric flow rate. Units: cubic feet per minute at 28 inches of water pressure drop. Mathematical dependency. Do not tamper. //
label IMR_Q(CHIPT_Qmax)    // Intake manifold runner actual volumetric flow rate. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //

label IMP_A((IMR_A * EC_N) / IM_N)    // Intake manifold plenum cross sectional area. Calculated automatically, but can be overridden. Units: square centimeters. //
label IMP_Qmax(IMP_A * 0.155 * 146.0)    // Intake manifold plenum theoretical maximum volumetric flow rate. Units: cubic feet per minute at 28 inches of water pressure drop. Mathematical dependency. Do not tamper. //
label IMP_Q((IMR_Q * EC_N) / IM_N)    // Intake manifold plenum actual volumetric flow rate. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //
label IMP_Vm(1.0)    // Intake manifold plenum volume multiplier. Determines the intake plenum volume in relation to the total displacement of cylinders it is feeding. //
label IMP_V((E_Dcc * IMP_Vm) / IM_N)    // Intake manifold plenum volume. Calculated automatically, but can be overridden. Units: cubic centimeters. //

label IM_AFR(17.5)    // Intake air/fuel ratio at wide-open throttle //
label IM_AFR_Cf(0.0)    // Intake air/fuel ratio overfuel correction factor. Can be used to lean out the mixture if the idle fueling causes it to be richer than desired at wide-open throttle. //
label IM_IT(0.99837)    // Intake throttle body idle position. 1.0 is fully closed, 0.0 is fully open. //
label IM_IF(0.31)    // Intake idle fueling. Can be used to make the air/fuel mixture richer off-throttle. 0.0 is no extra fueling. Adjustment increments of 0.1 or even 0.01 are recommended. //
label IM_TG(1.33)    // Intake throttle body gamma(non-linearity). 1.0 is fully linear. Higher values require more input to open the throttle body by the same amount. //




// Fuel Parameters Start //

label FUEL_NAME("Diesel")    // Fuel name. //
label FUEL_m(167.3137)    // Fuel molar mass. Units: grams per mole. //
label FUEL_rho(845.0 * (units.g / units.L))    // Fuel density. //
label FUEL_U(45.68 * (units.kJ / units.g))    // Fuel energy density. //
label FUEL_mAFR(11.0)    // Fuel molecular air-fuel ratio. //
label FUEL_etamax(0.8)    // Fuel maximum combustion efficiency. //
label FUEL_etadeltamax(0.5)    // Fuel burning efficiency randomness. //
label FUEL_etaminmu(0.6)    // Fuel low burning efficiency attenuation. //
label FUEL_TURBULENCEmax(4.0)    // Intake charge maximum turbulence. // 
label FUEL_DILUTIONmax(10.0)    // Intake charge maximum dilution. //


label TFS_Rbase(1.5)    // Flame speed base multiplier. //
label TFS_Rm(1.0)    // Flame speed additional multiplier. //
label TFS_Ryshift(0.0)    // Flame speed shift. //

// Fuel Parameters End //



// Exhaust Parameters Start //

label EH_N(2.0)    // Exhaust headers amount. Does not create exhaust headers automatically. //
label EH_VDm(1.0)    // Exhaust headers velocity decay multiplier. Determines the rate of exhaust gases velocity loss inside the exhaust headers. //
label EH_BMm(0.0)    // Exhaust headers backflow mixing. Determines the tendency of exhaust gases to flow back into the cylinder. 0.0 is absence of backflow. //

label EHPT_Somega(1500.0)    // Exhaust headers primary tube scavenging optimal RPM. Determines the engine speed at which the exhaust headers primary tube scavenge the best in theory. //
label EHPT_L(((((850.0 * (360.0 - EV_Oatdc)) / EHPT_Somega) - 3.0) * 25.4) - CHEP_L)    // Exhaust headers primary tube length. Calculated automatically, but can be overridden. Units: millimeters. //
label EHPT_A(CHEPO_A)    // Exhaust headers primary tube cross sectional area. Calculated automatically, but can be overridden. Units: square centimeters. //
label EHPT_Qmax(EHPT_A * 0.155 * 146.0)    // Exhaust headers primary tube theoretical maximum volumetric flow rate. Units: cubic feet per minute at 28 inches of water pressure drop. Calculated automatically. Mathematical dependency. Do not tamper. // 
label EHPT_Q(CHEPT_Qmax)    // Exhaust headers primary tube actual volumetric flow rate. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //

label EHC_L((EHPT_L + CHEP_L) / 2.0)    // Exhaust headers collector length. Calculated automatically, but can be overridden. Units: millimeters. //
label EHC_A(EHPT_A / 0.1716032341031912)    // Exhaust headers collector cross section area. Calculated automatically, but can be overridden. Units: square centimeters. //
label EHC_Qmax(EHC_A * 0.155 * 146.0)    // Exhaust headers collector theoretical maximum volumetric flow rate. Units: cubic feet per minute at 28 inches of water pressure drop. Calculated automatically. Mathematical dependency. Do not tamper. // 
label EHC_Q((EHPT_Q * EC_N) / EH_N)    // Exhaust headers collector actual volumetric flow rate. Calculated automatically, but can be overridden. Units: cubic feet per minute at 28 inches of water pressure drop. //
label EHC_V((EHC_A * EHC_L) / 10.0)    // Exhaust headers collector volume. Calculated automatically. Do not tamper. //

label EP_A(EHC_A)    // Exhaust pipe cross sectional area. Calculated automatically, but can be overridden. Units: square centimeters //
label EP_L(2000.0)    // Exhaust pipe length. Units: millimeters //
label EP_V((EP_A * EP_L) / 10.0)    // Exhaust pipe volume. Calculated automatically. Units: cubic centimeters. Do not tamper. //

// Exhaust Parameters End //



// Vehicle Parameters Start //

// Vehicle: BRDM-2M96i (Żbik, 7800 kilograms - stock gearbox (100 kilograms))
// Transmission: RENK ESM 350 (1800 kilokgrams, 8 gears forward)

label V_M(7700 + 1800.0)    // Vehicle mass. Units: kilograms. //

label V_B(2430.0)    // Vehicle width. Units: millimeters. //
label V_H(2425.0)    // Vehicle height. Units: millimeters. //

label V_Cd(0.55)    // Vehicle drag coefficient. //

label V_Frr(V_M * 9.80665 * 0.015)    // Vehicle rolling resistance. Calculated automatically, override only if you are a professional. Units: Newtons. //

label V_Ls(50.0) // Vehicle stopping distance. Units: meters. //
label V_Fb(((V_M * (27.77778 * 27.77778)) / 2.0) / V_Ls)    // Vehicle braking force. Calculated automatically, override only if you are a professional. Units: Newtons. //

// Tire size: 38X15.50R18
label T_B(403.86)    // Tire width. Units: millimeters. //
label TA_R(62.9)    // Tire aspect ratio. Percentage. //
label WR_D(15.0)    // Wheel rim diameter. Units: inches. //
label W_D((((T_B * TA_R) / 2540.0) * 2.0) + WR_D)    // Wheel total diameter. Calculated automatically, override only if you are a professional. Units: inches. //

// Vehicle Parameters End //



// Drivetrain Parameters Start //

//label E_Nmax((((E_Dcc / 1000.0) * 93.2125) * 9550.0) / E_omegamax)    // Peak engine torque. Used in drivetrain stiffness calculations. Calculated automatically, but can be overridden after measuring it on the dynamometer. Units: newton meters. //
label E_Nmax(4500.0)

label CL_Nmax(E_Nmax * 1.333)    // Clutch maximum torque. Calculated automatically, but can be overridden. Units: newton meters. //
label CL_phimax(5.0)    // Clutch maximum torsion angle. Units: degrees. //
label CL_phik(CL_Nmax / CL_phimax)    // Clutch torsional stiffness. Calculated automatically, override only if you are a professional. Units. newton meters per degree. //
label CL_zeta(2.0)    // Clutch torsional damping coefficient. //


label DR_phimax(5.0)    // Drivetrain maximum torsion angle. Units: degrees. //
label DR_phik((E_Nmax * 1.777) / DR_phimax)    // Drivetrain torsional stiffness. Calculated automatically, override only if you are a professional. Units: newton meters per degree. //
label DR_zeta(2.0)    // Drivetrain torsional damping coefficient. //


label FD_R(5.625)    // Final drive ratio //

label GB_R1(9.000)    // First gear ratio. Does not create gears automatically //
label GB_R2(4.710)    // Second gear ratio. Does not create gears automatically //
label GB_R3(2.760)    // Third gear ratio. Does not create gears automatically //
label GB_R4(1.630)    // Fourth gear ratio. Does not create gears automatically //
label GB_R5(1.000)    // Fifth gear ratio. Does not create gears automatically //
label GB_R6(0.650)    // Fifth gear ratio. Does not create gears automatically //
label GB_R7(0.430)    // Sixth gear ratio. Does not create gears automatically //
label GB_R8(0.270)    // Sixth gear ratio. Does not create gears automatically //

// Drivetrain Parameters End //



// Dynamometer Parameters Start //

label DYN_RPMmin(500.0)    // Dynamometer minimum speed. Units: revolutions per minute. //
label DYN_RPMmax(E_omegamax)    // Dynamometer maximum speed. Calculated automatically, but can be overridden. Units: revolutions per minute. //
label DYN_dRPM(100.0)    // Dynamometer hold speed steps. Units: revolutions per minute. //

// Dynamometer Parameters End //


// Wires start //

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
}

// Wires end //

// Distributor start //

public node Engine_Distributor {
    input wires;
    input timing_curve;
    input rev_limit: E_omegamax * units.rpm;
    input limiter_duration: LICO_t * units.sec;
    alias output __out:
        ignition_module(timing_curve: timing_curve, rev_limit: rev_limit, limiter_duration: limiter_duration)
            .connect_wire(wires.wire1,(-1.0 * (SIM_MCf * units.deg)) +  0 * units.deg)
            .connect_wire(wires.wire2,(-1.0 * (SIM_MCf * units.deg)) +  90 * units.deg)
            .connect_wire(wires.wire3,(-1.0 * (SIM_MCf * units.deg)) +  270 * units.deg)
            .connect_wire(wires.wire4,(-1.0 * (SIM_MCf * units.deg)) +  360 * units.deg)
            .connect_wire(wires.wire5,(-1.0 * (SIM_MCf * units.deg)) +  450 * units.deg)
            .connect_wire(wires.wire6,(-1.0 * (SIM_MCf * units.deg)) +  540 * units.deg)
            .connect_wire(wires.wire7,(-1.0 * (SIM_MCf * units.deg)) +  180 * units.deg)
            .connect_wire(wires.wire8,(-1.0 * (SIM_MCf * units.deg)) +  630 * units.deg);
}

// Distributor End //

// Camshaft Lobes Start //

private node add_sym_sample {
    input angle;
    input lift;
    input this;
    alias output __out: this;
    
    this.add_sample(angle * units.deg, lift * units.mm)
    this.add_sample(-angle * units.deg, lift * units.mm)
}

