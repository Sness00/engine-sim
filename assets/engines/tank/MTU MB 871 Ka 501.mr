// Camshaft Lobes End //

// Camshafts Start //

public node Engine_Camshaft_Builder {
    output intake_cam_1: Intake_Camshaft_1;
    output exhaust_cam_1: Exhaust_Camshaft_1;

    output intake_cam_2: Intake_Camshaft_2;
    output exhaust_cam_2: Exhaust_Camshaft_2;

    camshaft_parameters Camshaft_Parameters(
        advance: 0.0 * units.deg,
        base_radius: (CSS_D / 2.0) * units.mm
    )

    camshaft Intake_Camshaft_1(Camshaft_Parameters, lobe_profile: Engine_Camshaft_Intake_Lobe())
    camshaft Exhaust_Camshaft_1(Camshaft_Parameters, lobe_profile: Engine_Camshaft_Exhaust_Lobe())

    camshaft Intake_Camshaft_2(Camshaft_Parameters, lobe_profile: Engine_Camshaft_Intake_Lobe())
    camshaft Exhaust_Camshaft_2(Camshaft_Parameters, lobe_profile: Engine_Camshaft_Exhaust_Lobe())

    Intake_Camshaft_1
        .add_lobe(CSIL_C + (-1.0 * (SIM_MCf * units.deg)) + (0 * units.deg))
        .add_lobe(CSIL_C + (-1.0 * (SIM_MCf * units.deg)) + (270 * units.deg))
        .add_lobe(CSIL_C + (-1.0 * (SIM_MCf * units.deg)) + (450 * units.deg))
        .add_lobe(CSIL_C + (-1.0 * (SIM_MCf * units.deg)) + (180 * units.deg))
    Exhaust_Camshaft_1
        .add_lobe(CSEL_C + (-1.0 * (SIM_MCf * units.deg)) + (0 * units.deg))
        .add_lobe(CSEL_C + (-1.0 * (SIM_MCf * units.deg)) + (270 * units.deg))
        .add_lobe(CSEL_C + (-1.0 * (SIM_MCf * units.deg)) + (450 * units.deg))
        .add_lobe(CSEL_C + (-1.0 * (SIM_MCf * units.deg)) + (180 * units.deg))

    Intake_Camshaft_2
        .add_lobe(CSIL_C + (-1.0 * (SIM_MCf * units.deg)) + (90 * units.deg))
        .add_lobe(CSIL_C + (-1.0 * (SIM_MCf * units.deg)) + (360 * units.deg))
        .add_lobe(CSIL_C + (-1.0 * (SIM_MCf * units.deg)) + (540 * units.deg))
        .add_lobe(CSIL_C + (-1.0 * (SIM_MCf * units.deg)) + (630 * units.deg))
    Exhaust_Camshaft_2
        .add_lobe(CSEL_C + (-1.0 * (SIM_MCf * units.deg)) + (90 * units.deg))
        .add_lobe(CSEL_C + (-1.0 * (SIM_MCf * units.deg)) + (360 * units.deg))
        .add_lobe(CSEL_C + (-1.0 * (SIM_MCf * units.deg)) + (540 * units.deg))
        .add_lobe(CSEL_C + (-1.0 * (SIM_MCf * units.deg)) + (630 * units.deg))
}

// Camshafts End //

// Cylinder Head Start //

private node add_flow_sample {
    input lift;
    input flow;
    input this;
    alias output __out: this;

    this.add_sample(lift * units.mm, k_28inH2O(flow))
}

public node Engine_Cylinder_Head {
    input intake_camshaft;
    input exhaust_camshaft;
    input flip_display: false;
    alias output __out: head;

    label AIVCB(IV_A / 10.0)
    label AIVC_0(AIVCB * 0.0)
    label AIVC_1(AIVCB * 1.0)
    label AIVC_2(AIVCB * 2.0)
    label AIVC_3(AIVCB * 3.0)
    label AIVC_4(AIVCB * 4.0)
    label AIVC_5(AIVCB * 5.0)
    label AIVC_6(AIVCB * 6.0)
    label AIVC_7(AIVCB * 7.0)
    label AIVC_8(AIVCB * 8.0)
    label AIVC_9(AIVCB * 9.0)
    label AIVC_10(AIVCB * 10.0)
    label AIVC_11(AIVCB * 11.0)
    label AIVC_12(AIVCB * 12.0)
    label AIVC_13(AIVCB * 13.0)
    label AIVC_14(AIVCB * 14.0)
    label AIVC_15(AIVCB * 15.0)
    label AIVC_16(AIVCB * 16.0)
    label AIVC_17(AIVCB * 17.0)
    label AIVC_18(AIVCB * 18.0)
    label AIVC_19(AIVCB * 19.0)
    label AIVC_20(AIVCB * 20.0)

    label AEVCB(EV_A / 10.0)
    label AEVC_0(AEVCB * 0.0)
    label AEVC_1(AEVCB * 1.0)
    label AEVC_2(AEVCB * 2.0)
    label AEVC_3(AEVCB * 3.0)
    label AEVC_4(AEVCB * 4.0)
    label AEVC_5(AEVCB * 5.0)
    label AEVC_6(AEVCB * 6.0)
    label AEVC_7(AEVCB * 7.0)
    label AEVC_8(AEVCB * 8.0)
    label AEVC_9(AEVCB * 9.0)
    label AEVC_10(AEVCB * 10.0)
    label AEVC_11(AEVCB * 11.0)
    label AEVC_12(AEVCB * 12.0)
    label AEVC_13(AEVCB * 13.0)
    label AEVC_14(AEVCB * 14.0)
    label AEVC_15(AEVCB * 15.0)
    label AEVC_16(AEVCB * 16.0)
    label AEVC_17(AEVCB * 17.0)
    label AEVC_18(AEVCB * 18.0)
    label AEVC_19(AEVCB * 19.0)
    label AEVC_20(AEVCB * 20.0)

    function intake_flow(1 * units.mm)
    intake_flow
        .add_flow_sample(0, 0)
        .add_flow_sample(1, IV_Qmax * ((CHIPIV_Ravg + 0.1250000000000 + (AIVC_1 / IV_A)) / ((IV_A / AIVC_1) + (CHIPTIVRavg_R * (AIVC_1 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_1 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_1 / CHIPI_A)))))
        .add_flow_sample(2, IV_Qmax * ((CHIPIV_Ravg + 0.2227246795350 + (AIVC_2 / IV_A)) / ((IV_A / AIVC_2) + (CHIPTIVRavg_R * (AIVC_2 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_2 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_2 / CHIPI_A)))))
        .add_flow_sample(3, IV_Qmax * ((CHIPIV_Ravg + 0.3122561916210 + (AIVC_3 / IV_A)) / ((IV_A / AIVC_3) + (CHIPTIVRavg_R * (AIVC_3 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_3 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_3 / CHIPI_A)))))
        .add_flow_sample(4, IV_Qmax * ((CHIPIV_Ravg + 0.3968502629920 + (AIVC_4 / IV_A)) / ((IV_A / AIVC_4) + (CHIPTIVRavg_R * (AIVC_4 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_4 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_4 / CHIPI_A)))))
        .add_flow_sample(5, IV_Qmax * ((CHIPIV_Ravg + 0.4779528070820 + (AIVC_5 / IV_A)) / ((IV_A / AIVC_5) + (CHIPTIVRavg_R * (AIVC_5 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_5 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_5 / CHIPI_A)))))
        .add_flow_sample(6, IV_Qmax * ((CHIPIV_Ravg + 0.5563772816930 + (AIVC_6 / IV_A)) / ((IV_A / AIVC_6) + (CHIPTIVRavg_R * (AIVC_6 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_6 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_6 / CHIPI_A)))))
        .add_flow_sample(7, IV_Qmax * ((CHIPIV_Ravg + 0.6326425231000 + (AIVC_7 / IV_A)) / ((IV_A / AIVC_7) + (CHIPTIVRavg_R * (AIVC_7 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_7 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_7 / CHIPI_A)))))
        .add_flow_sample(8, IV_Qmax * ((CHIPIV_Ravg + 0.7071067811870 + (AIVC_8 / IV_A)) / ((IV_A / AIVC_8) + (CHIPTIVRavg_R * (AIVC_8 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_8 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_8 / CHIPI_A)))))
        .add_flow_sample(9, IV_Qmax * ((CHIPIV_Ravg + 0.7800314336440 + (AIVC_9 / IV_A)) / ((IV_A / AIVC_9) + (CHIPTIVRavg_R * (AIVC_9 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_9 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_9 / CHIPI_A)))))
        .add_flow_sample(10, IV_Qmax * ((CHIPIV_Ravg + 0.851615086322 + (AIVC_10 / IV_A)) / ((IV_A / AIVC_10) + (CHIPTIVRavg_R * (AIVC_10 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_10 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_10 / CHIPI_A)))))
        .add_flow_sample(11, IV_Qmax * ((CHIPIV_Ravg + 0.922013437705 + (AIVC_11 / IV_A)) / ((IV_A / AIVC_11) + (CHIPTIVRavg_R * (AIVC_11 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_11 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_11 / CHIPI_A)))))
        .add_flow_sample(12, IV_Qmax * ((CHIPIV_Ravg + 0.991351614125 + (AIVC_12 / IV_A)) / ((IV_A / AIVC_12) + (CHIPTIVRavg_R * (AIVC_12 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_12 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_12 / CHIPI_A)))))
        .add_flow_sample(13, IV_Qmax * ((CHIPIV_Ravg + 1.059732222790 + (AIVC_13 / IV_A)) / ((IV_A / AIVC_13) + (CHIPTIVRavg_R * (AIVC_13 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_13 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_13 / CHIPI_A)))))
        .add_flow_sample(14, IV_Qmax * ((CHIPIV_Ravg + 1.127240825740 + (AIVC_14 / IV_A)) / ((IV_A / AIVC_14) + (CHIPTIVRavg_R * (AIVC_14 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_14 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_14 / CHIPI_A)))))
        .add_flow_sample(15, IV_Qmax * ((CHIPIV_Ravg + 1.193949786510 + (AIVC_15 / IV_A)) / ((IV_A / AIVC_15) + (CHIPTIVRavg_R * (AIVC_15 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_15 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_15 / CHIPI_A)))))
        .add_flow_sample(16, IV_Qmax * ((CHIPIV_Ravg + 1.259921049890 + (AIVC_16 / IV_A)) / ((IV_A / AIVC_16) + (CHIPTIVRavg_R * (AIVC_16 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_16 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_16 / CHIPI_A)))))
        .add_flow_sample(17, IV_Qmax * ((CHIPIV_Ravg + 1.325208198940 + (AIVC_17 / IV_A)) / ((IV_A / AIVC_17) + (CHIPTIVRavg_R * (AIVC_17 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_17 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_17 / CHIPI_A)))))
        .add_flow_sample(18, IV_Qmax * ((CHIPIV_Ravg + 1.389858008690 + (AIVC_18 / IV_A)) / ((IV_A / AIVC_18) + (CHIPTIVRavg_R * (AIVC_18 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_18 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_18 / CHIPI_A)))))
        .add_flow_sample(19, IV_Qmax * ((CHIPIV_Ravg + 1.453911640940 + (AIVC_19 / IV_A)) / ((IV_A / AIVC_19) + (CHIPTIVRavg_R * (AIVC_19 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_19 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_19 / CHIPI_A)))))
        .add_flow_sample(20, IV_Qmax * ((CHIPIV_Ravg + 1.517405577510 + (AIVC_20 / IV_A)) / ((IV_A / AIVC_20) + (CHIPTIVRavg_R * (AIVC_20 / CHIPT_A)) + (CHIPIVRavg_R * (AIVC_20 / CHIP_A)) + (CHIPIIVRavg_R * (AIVC_20 / CHIPI_A)))))

    function exhaust_flow(1 * units.mm)
    exhaust_flow
        .add_flow_sample(0, 0)
        .add_flow_sample(1, EV_Qmax * ((CHEPEV_Ravg + 0.1250000000000 + (AEVC_1 / EV_A)) / ((EV_A / AEVC_1) + (CHEPTEVRavg_R * (AEVC_1 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_1 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_1 / CHEPO_A)))))
        .add_flow_sample(2, EV_Qmax * ((CHEPEV_Ravg + 0.2227246795350 + (AEVC_2 / EV_A)) / ((EV_A / AEVC_2) + (CHEPTEVRavg_R * (AEVC_2 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_2 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_2 / CHEPO_A)))))
        .add_flow_sample(3, EV_Qmax * ((CHEPEV_Ravg + 0.3122561916210 + (AEVC_3 / EV_A)) / ((EV_A / AEVC_3) + (CHEPTEVRavg_R * (AEVC_3 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_3 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_3 / CHEPO_A)))))
        .add_flow_sample(4, EV_Qmax * ((CHEPEV_Ravg + 0.3968502629920 + (AEVC_4 / EV_A)) / ((EV_A / AEVC_4) + (CHEPTEVRavg_R * (AEVC_4 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_4 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_4 / CHEPO_A)))))
        .add_flow_sample(5, EV_Qmax * ((CHEPEV_Ravg + 0.4779528070820 + (AEVC_5 / EV_A)) / ((EV_A / AEVC_5) + (CHEPTEVRavg_R * (AEVC_5 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_5 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_5 / CHEPO_A)))))
        .add_flow_sample(6, EV_Qmax * ((CHEPEV_Ravg + 0.5563772816930 + (AEVC_6 / EV_A)) / ((EV_A / AEVC_6) + (CHEPTEVRavg_R * (AEVC_6 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_6 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_6 / CHEPO_A)))))
        .add_flow_sample(7, EV_Qmax * ((CHEPEV_Ravg + 0.6326425231000 + (AEVC_7 / EV_A)) / ((EV_A / AEVC_7) + (CHEPTEVRavg_R * (AEVC_7 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_7 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_7 / CHEPO_A)))))
        .add_flow_sample(8, EV_Qmax * ((CHEPEV_Ravg + 0.7071067811870 + (AEVC_8 / EV_A)) / ((EV_A / AEVC_8) + (CHEPTEVRavg_R * (AEVC_8 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_8 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_8 / CHEPO_A)))))
        .add_flow_sample(9, EV_Qmax * ((CHEPEV_Ravg + 0.7800314336440 + (AEVC_9 / EV_A)) / ((EV_A / AEVC_9) + (CHEPTEVRavg_R * (AEVC_9 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_9 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_9 / CHEPO_A)))))
        .add_flow_sample(10, EV_Qmax * ((CHEPEV_Ravg + 0.851615086322 + (AEVC_10 / EV_A)) / ((EV_A / AEVC_10) + (CHEPTEVRavg_R * (AEVC_10 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_10 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_10 / CHEPO_A)))))
        .add_flow_sample(11, EV_Qmax * ((CHEPEV_Ravg + 0.922013437705 + (AEVC_11 / EV_A)) / ((EV_A / AEVC_11) + (CHEPTEVRavg_R * (AEVC_11 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_11 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_11 / CHEPO_A)))))
        .add_flow_sample(12, EV_Qmax * ((CHEPEV_Ravg + 0.991351614125 + (AEVC_12 / EV_A)) / ((EV_A / AEVC_12) + (CHEPTEVRavg_R * (AEVC_12 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_12 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_12 / CHEPO_A)))))
        .add_flow_sample(13, EV_Qmax * ((CHEPEV_Ravg + 1.059732222790 + (AEVC_13 / EV_A)) / ((EV_A / AEVC_13) + (CHEPTEVRavg_R * (AEVC_13 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_13 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_13 / CHEPO_A)))))
        .add_flow_sample(14, EV_Qmax * ((CHEPEV_Ravg + 1.127240825740 + (AEVC_14 / EV_A)) / ((EV_A / AEVC_14) + (CHEPTEVRavg_R * (AEVC_14 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_14 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_14 / CHEPO_A)))))
        .add_flow_sample(15, EV_Qmax * ((CHEPEV_Ravg + 1.193949786510 + (AEVC_15 / EV_A)) / ((EV_A / AEVC_15) + (CHEPTEVRavg_R * (AEVC_15 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_15 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_15 / CHEPO_A)))))
        .add_flow_sample(16, EV_Qmax * ((CHEPEV_Ravg + 1.259921049890 + (AEVC_16 / EV_A)) / ((EV_A / AEVC_16) + (CHEPTEVRavg_R * (AEVC_16 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_16 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_16 / CHEPO_A)))))
        .add_flow_sample(17, EV_Qmax * ((CHEPEV_Ravg + 1.325208198940 + (AEVC_17 / EV_A)) / ((EV_A / AEVC_17) + (CHEPTEVRavg_R * (AEVC_17 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_17 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_17 / CHEPO_A)))))
        .add_flow_sample(18, EV_Qmax * ((CHEPEV_Ravg + 1.389858008690 + (AEVC_18 / EV_A)) / ((EV_A / AEVC_18) + (CHEPTEVRavg_R * (AEVC_18 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_18 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_18 / CHEPO_A)))))
        .add_flow_sample(19, EV_Qmax * ((CHEPEV_Ravg + 1.453911640940 + (AEVC_19 / EV_A)) / ((EV_A / AEVC_19) + (CHEPTEVRavg_R * (AEVC_19 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_19 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_19 / CHEPO_A)))))
        .add_flow_sample(20, EV_Qmax * ((CHEPEV_Ravg + 1.517405577510 + (AEVC_20 / EV_A)) / ((EV_A / AEVC_20) + (CHEPTEVRavg_R * (AEVC_20 / CHEPT_A)) + (CHEPEVRavg_R * (AEVC_20 / CHEP_A)) + (CHEPOEVRavg_R * (AEVC_20 / CHEPO_A)))))
    
    cylinder_head head(
        chamber_volume: CHCC_V * units.cc,
        intake_runner_cross_section_area: CHIPT_A * units.cm2,
        intake_runner_volume: CHIP_V * units.cc,
        exhaust_runner_cross_section_area: CHEPT_A * units.cm2,
        exhaust_runner_volume: CHEP_V * units.cc,
        
        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        intake_camshaft: intake_camshaft,
        exhaust_camshaft: exhaust_camshaft,
        flip_display: flip_display
    )
}  

// Cylinder Head End //

// Turbulence to Flame Speed Ratio Node Start //

private node Turbulence_To_Flame_Speed_Ratio {
    alias output __out:
        function(5.0)
            .add_sample((0.0), (TFS_Rbase * TFS_Rm) * (2.0 + TFS_Ryshift))
            .add_sample((5.0), (TFS_Rbase * TFS_Rm) * (5.0 + TFS_Ryshift))
            .add_sample((10.0), (TFS_Rbase * TFS_Rm) * (10.0 + TFS_Ryshift))
            .add_sample((15.0), (TFS_Rbase * TFS_Rm) * (15.0 + TFS_Ryshift))
            .add_sample((20.0), (TFS_Rbase * TFS_Rm) * (20.0 + TFS_Ryshift))
            .add_sample((25.0), (TFS_Rbase * TFS_Rm) * (25.0 + TFS_Ryshift))
            .add_sample((30.0), (TFS_Rbase * TFS_Rm) * (30.0 + TFS_Ryshift))
            .add_sample((35.0), (TFS_Rbase * TFS_Rm) * (35.0 + TFS_Ryshift))
            .add_sample((40.0), (TFS_Rbase * TFS_Rm) * (40.0 + TFS_Ryshift))
            .add_sample((45.0), (TFS_Rbase * TFS_Rm) * (45.0 + TFS_Ryshift));
}

// Turbulence to Flame Speed Ratio Node End //

// Engine assembly start //

public node Engine {
    alias output __out: engine;

// Miscellaneous parameters start //

    engine engine(
        name: "MTU MB 871 Ka-501",
        starter_torque: SM_Ftq * units.Nm,
        starter_speed: SM_omega * units.rpm,
        redline: TACHO_REDLINE * units.rpm,
        fuel: fuel(
            name: FUEL_NAME,
            molecular_mass: FUEL_m * units.g,
            density: FUEL_rho,
            energy_density: FUEL_U,
            molecular_afr: FUEL_mAFR,
            max_burning_efficiency: FUEL_etamax,
            burning_efficiency_randomness: FUEL_etadeltamax,
            low_efficiency_attenuation: FUEL_etaminmu,
            max_turbulence_effect: FUEL_TURBULENCEmax,
            max_dilution_effect: FUEL_DILUTIONmax,
            turbulence_to_flame_speed_ratio: Turbulence_To_Flame_Speed_Ratio()
        ),
        throttle_gamma: IM_TG,
        // convolution: AUDIO_CONV,
        hf_gain: AUDIO_HFG,
        jitter: AUDIO_HFN,
        noise: AUDIO_LFN,
        simulation_frequency: SIM_f,
        // max_sle_solver_steps: SIM_SLESd,
        // fluid_simulation_steps: SIM_FSd,
        dyno_min_speed: DYN_RPMmin * units.rpm,
        dyno_max_speed: DYN_RPMmax * units.rpm,
        dyno_hold_step: DYN_dRPM * units.rpm
    )

// Miscellaneous parameters end //

// Wires start //

    wires wires()

// Wires end //

// Crankshaft Start //

    crankshaft Crankshaft_1(
        throw: CT_L * units.mm,
        mass: C_M * units.g,
        flywheel_mass: FW_M * units.g,
        friction_torque: (C_Fmu + CP_Fmu + CHB_Fmu + FW_Fmu + CS_Fmu + CSG_Fmu) * units.Nm,
        moment_of_inertia: C_MOI + FW_MOI + CSS_MOI + CSIL_MOI + CSEL_MOI + CSG_MOI + CR_MOIC + CP_MOI + CHB_MOI,
        position_x: 0.0,
        position_y: 0.0,
        tdc: (-1.0 * (SIM_MCf * units.deg)) + 135.0 * units.deg
    )

    rod_journal Rod_Journal_1(angle: 0 * units.deg)
    rod_journal Rod_Journal_2(angle: 270 * units.deg)
    rod_journal Rod_Journal_3(angle: 450 * units.deg)
    rod_journal Rod_Journal_4(angle: 180 * units.deg)

    Crankshaft_1
        .add_rod_journal(Rod_Journal_1)
        .add_rod_journal(Rod_Journal_2)
        .add_rod_journal(Rod_Journal_3)
        .add_rod_journal(Rod_Journal_4)

// Crankshaft End //

// Pistons Parameters Start //
    
    piston_parameters Piston_Parameters(
        mass: P_M * units.g,
        compression_height: PCH_H * units.mm,
        wrist_pin_position: 0.0,
        displacement: 0.0,
        blowby: k_28inH2O(PR_B)
    )

// Pistons End //

// Connecting Rods Parameters Start //

    connecting_rod_parameters Connecting_Rod_Parameters(
        mass: CR_M * units.g,
        length: CR_L * units.mm,
        moment_of_inertia: CR_MOI,
        center_of_mass: 0.0
    )

// Connnecting Rods Parameters End //

// Cylinder Bank Parameters Start //

    cylinder_bank_parameters Cylinder_Bank_Parameters(
        bore: E_B * units.mm,
        deck_height: (CT_L + CR_L + PCH_H) * units.mm
    )

// Cylinder Bank Parameters End //

// Intake Manifolds Start //
    
    intake Intake_Manifold_1(
        plenum_cross_section_area: IMP_A * units.cm2,
        plenum_volume: IMP_V * units.cc,
        intake_flow_rate: k_28inH2O(IMP_Q),
        runner_length: IMR_L * units.mm,
        runner_flow_rate: k_28inH2O(IMR_Q),
        idle_throttle_plate_position: IM_IT,
        idle_flow_rate: k_carb(IM_IF),
        molecular_afr: (13.8 + IM_AFR_Cf) * (IM_AFR / 14.7),
        velocity_decay: IM_VDm
    )

// Intake Manifolds End //

// Exhaust Headers Start //

    exhaust_system_parameters Exhaust_System_Parameters(
        length: (EHC_L + EP_L) * units.mm,
        collector_cross_section_area: EP_A * units.cm2,
        volume: (EHC_V + EP_V) * units.cc,
        outlet_flow_rate: k_28inH2O(EHC_Q),
        primary_tube_length: EHPT_L * units.mm,
        primary_flow_rate: k_28inH2O(EHPT_Q),
        velocity_decay: EH_VDm/*,*/
        // backflow_atmospheric_mixing: EH_BMm
    )

    exhaust_system Exhaust_Headers_1(Exhaust_System_Parameters, impulse_response: ir_lib.minimal_muffling_01, audio_volume: 1.0)
    exhaust_system Exhaust_Headers_2(Exhaust_System_Parameters, impulse_response: ir_lib.minimal_muffling_03, audio_volume: 1.0)

// Exhaust Headers End //

// Unequal Length Header Scaling Start //

    label spacing_factor(1.75)
    label exhaust_delay_coeff(1.25)
    label flange_density(0.90 * exhaust_delay_coeff)

// Unequal Length Header Scaling End //

    label pl0  ((6.0 * E_B * spacing_factor / flange_density))
    label pl1  ((3.0 * E_B * spacing_factor / flange_density))
    label pl2  ((2.0 * E_B * spacing_factor / flange_density))
    label pl3  ((7.0 * E_B * spacing_factor / flange_density))

    label pl4  ((5.0 * E_B * spacing_factor / flange_density))
    label pl5  ((2.0 * E_B * spacing_factor / flange_density))
    label pl6  ((2.0 * E_B * spacing_factor / flange_density))
    label pl7  ((8.0 * E_B * spacing_factor / flange_density))

// Cylinder Banks Start //

    cylinder_bank Cylinder_Bank_1(Cylinder_Bank_Parameters, angle: 45.0 * units.deg)
        Cylinder_Bank_1
            .add_cylinder(
                piston: piston(Piston_Parameters),
                connecting_rod: connecting_rod(Connecting_Rod_Parameters),
                rod_journal: Rod_Journal_1,
                intake: Intake_Manifold_1,
                exhaust_system: Exhaust_Headers_1,
                primary_length: (pl0) * units.mm,
                sound_attenuation: 1.00,
                ignition_wire: wires.wire1
            )
            .add_cylinder(
                piston: piston(Piston_Parameters),
                connecting_rod: connecting_rod(Connecting_Rod_Parameters),
                rod_journal: Rod_Journal_2,
                intake: Intake_Manifold_1,
                exhaust_system: Exhaust_Headers_1,
                primary_length: (pl1) * units.mm,
                sound_attenuation: 1.00,
                ignition_wire: wires.wire3
            )
            .add_cylinder(
                piston: piston(Piston_Parameters),
                connecting_rod: connecting_rod(Connecting_Rod_Parameters),
                rod_journal: Rod_Journal_3,
                intake: Intake_Manifold_1,
                exhaust_system: Exhaust_Headers_1,
                primary_length: (pl2) * units.mm,
                sound_attenuation: 1.00,
                ignition_wire: wires.wire5
            )
            .add_cylinder(
                piston: piston(Piston_Parameters),
                connecting_rod: connecting_rod(Connecting_Rod_Parameters),
                rod_journal: Rod_Journal_4,
                intake: Intake_Manifold_1,
                exhaust_system: Exhaust_Headers_1,
                primary_length: (pl3) * units.mm,
                sound_attenuation: 1.00,
                ignition_wire: wires.wire7
            )

    cylinder_bank Cylinder_Bank_2(Cylinder_Bank_Parameters, angle: -45.0 * units.deg)
        Cylinder_Bank_2
            .add_cylinder(
                piston: piston(Piston_Parameters),
                connecting_rod: connecting_rod(Connecting_Rod_Parameters),
                rod_journal: Rod_Journal_1,
                intake: Intake_Manifold_1,
                exhaust_system: Exhaust_Headers_2,
                primary_length: (pl4) * units.mm,
                sound_attenuation: 1.00,
                ignition_wire: wires.wire2
            )
            .add_cylinder(
                piston: piston(Piston_Parameters),
                connecting_rod: connecting_rod(Connecting_Rod_Parameters),
                rod_journal: Rod_Journal_2,
                intake: Intake_Manifold_1,
                exhaust_system: Exhaust_Headers_2,
                primary_length: (pl5) * units.mm,
                sound_attenuation: 1.00,
                ignition_wire: wires.wire4
            )
            .add_cylinder(
                piston: piston(Piston_Parameters),
                connecting_rod: connecting_rod(Connecting_Rod_Parameters),
                rod_journal: Rod_Journal_3,
                intake: Intake_Manifold_1,
                exhaust_system: Exhaust_Headers_2,
                primary_length: (pl6) * units.mm,
                sound_attenuation: 1.00,
                ignition_wire: wires.wire6
            )
            .add_cylinder(
                piston: piston(Piston_Parameters),
                connecting_rod: connecting_rod(Connecting_Rod_Parameters),
                rod_journal: Rod_Journal_4,
                intake: Intake_Manifold_1,
                exhaust_system: Exhaust_Headers_2,
                primary_length: (pl7) * units.mm,
                sound_attenuation: 1.00,
                ignition_wire: wires.wire8
            )
    
    engine.add_cylinder_bank(Cylinder_Bank_1)
    engine.add_cylinder_bank(Cylinder_Bank_2)

    engine.add_crankshaft(Crankshaft_1)

    Engine_Camshaft_Builder camshaft()

    Cylinder_Bank_1.set_cylinder_head(
        Engine_Cylinder_Head(
            intake_camshaft: camshaft.intake_cam_1,
            exhaust_camshaft: camshaft.exhaust_cam_1,
            flip_display: true
        )
    )

    Cylinder_Bank_2.set_cylinder_head(
        Engine_Cylinder_Head(
            intake_camshaft: camshaft.intake_cam_2,
            exhaust_camshaft: camshaft.exhaust_cam_2,
            flip_display: false
        )
    )

// Cylinder Banks End //

// Ignition Start //

    function timing_curve(300 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 0.0 * units.deg)
        .add_sample(300 * units.rpm, 10.0 * units.deg)
        .add_sample(600 * units.rpm, 10.0 * units.deg)   
        .add_sample(900 * units.rpm, 20.0 * units.deg)
        .add_sample(1200 * units.rpm, 25.0 * units.deg)
        .add_sample(1500 * units.rpm, 25.0 * units.deg)
        .add_sample(1800 * units.rpm, 25.0 * units.deg)
        .add_sample(2100 * units.rpm, 26.0 * units.deg)
        .add_sample(2400 * units.rpm, 27.0 * units.deg)

    engine.add_ignition_module(
        Engine_Distributor(
            wires: wires,
            timing_curve: timing_curve
        )
    )
}

// Ignition End //

// Engine assembly end //

// Vehicle Start //

public node Vehicle {
    alias output __out:
        vehicle(
            mass: V_M * units.kg,
            drag_coefficient: V_Cd,
            cross_sectional_area: (V_B * units.mm) * (V_H * units.mm),
            diff_ratio: FD_R,
            tire_radius: (W_D / 2) * units.inch,
            rolling_resistance: V_Frr * units.Nm/*,*/
            // max_brake_force: V_Fb * units.Nm,
            // simulate_flex: true,
            // stiffness: DR_phik * units.Nm / units.deg,
            // limit_flex: true,
            // max_flex: DR_phimax * units.deg,
            // damping: DR_zeta
        );
}

// Vehicle End //

// Transmission start //

public node Transmission {
    alias output __out:
        transmission(
            max_clutch_torque: CL_Nmax * units.Nm/*,*/
            // simulate_flex: true,
            // clutch_stiffness: CL_phik * units.Nm / units.deg,
            // limit_clutch_flex: true,
            // max_clutch_flex: CL_phimax * units.deg,
            // clutch_damping: CL_zeta
        )
        .add_gear(GB_R1)
        .add_gear(GB_R2)
        .add_gear(GB_R3)
        .add_gear(GB_R4)
        .add_gear(GB_R5)
        .add_gear(GB_R6)
        .add_gear(GB_R7)
        .add_gear(GB_R8);
}

// Transmission End //

public node main {
    set_engine(Engine())
    set_vehicle(Vehicle())
    set_transmission(Transmission())
}

main()